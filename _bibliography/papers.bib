@article{kiziroglou_milliwatt_2019,
	title = {Milliwatt {Power} {Supply} by {Dynamic} {Thermoelectric} {Harvesting}},
	volume = {1407},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
	issn = {1742-6588, 1742-6596},
	url = {https://iopscience.iop.org/article/10.1088/1742-6596/1407/1/012098},
	doi = {10.1088/1742-6596/1407/1/012098},
	abstract = {In this work we demonstrate a power supply that collects thermal energy from temperature fluctuations in time, to provide regulated power in the milliwatt range. It is based on the dynamic thermoelectric energy harvesting concept, in which a phase change material is used to store heat and create spatial heat flow from temperature transients. A simple, costeffective and reproducible fabrication method is employed, based on 3D printing and off-theshelf components. The harvester is integrated with a commercial power management module and supercapacitor storage. Output energy up to 2 J is demonstrated from temperature cycles corresponding to avionic applications. The demonstration includes harvesting while powering a 10 kΩ analogue voltmeter directly from the supercapacitor, including during cold-starting.},
	language = {en},
	number = {1},
	urldate = {2025-07-09},
	journal = {Journal of Physics: Conference Series},
	author = {Kiziroglou, M E and Wright, S W and Shi, M and Boyle, D E and Becker, Th and Evans, J W and Yeatman, E M},
	month = nov,
	year = {2019},
	note = {Publisher: IOP Publishing},
	pages = {012098},
	preview={jphys-2019.png},
}

@article{shi_energy_2019,
	title = {Energy {Harvesting} {Piezoelectric} {Wind} {Speed} {Sensor}},
	volume = {1407},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
	issn = {1742-6588, 1742-6596},
	url = {https://iopscience.iop.org/article/10.1088/1742-6596/1407/1/012044},
	doi = {10.1088/1742-6596/1407/1/012044},
	abstract = {In this paper, we demonstrate a miniature wind speed sensor consisting of a triangleshaped bluff body attached to the free end of a cantilever incorporating a commercial PVDF piezoelectric film. In the wind, the bluff body causes regular vibration of the cantilever based on galloping, and the piezoelectric film converts the vibration energy into electrical energy. The vibration frequency of this device has an approximately linear dependence on wind speed, and so can be used to detect wind speed directly with high accuracy. In wind tunnel tests, a wind speed sensor based on this principle could detect the wind speed from 4.45 to 10 m/s, and measured speed was typically within 2\% of the value obtained using a Pitot tube.},
	language = {en},
	number = {1},
	urldate = {2025-07-09},
	journal = {Journal of Physics: Conference Series},
	author = {Shi, Mayue and Yeatman, Eric M. and Holmes, Andrew S.},
	month = nov,
	year = {2019},
	note = {Publisher: IOP Publishing},
	pages = {012044},
	preview={jphys-2019-2.png},
}

